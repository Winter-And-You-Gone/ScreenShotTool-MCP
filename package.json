{
  "name": "screenshottool-mcp",
  "version": "0.1.0",
  "description": "Generic Windows UI Automation MCP server: app launch, window/UIA control, pipelines (named steps, exports, expect, retry, finally, continue), and declarative App Packs for any desktop app.",
  "type": "module",
  "bin": {
    "screenshottool-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test --import tsx tests/*.test.ts",
    "smoke:notepad": "tsx tests/smoke-notepad.ts",
    "smoke:type-text": "tsx tests/smoke-type-text.ts",
    "smoke:menu-click": "tsx tests/smoke-menu-click.ts",
    "smoke:no-cursor-click": "tsx tests/smoke-no-cursor-click.ts",
    "smoke:print-capture": "tsx tests/smoke-print-capture.ts",
    "smoke:p1-fixes": "tsx tests/smoke-p1-fixes.ts",
    "smoke:perf": "tsx tests/smoke-perf.ts",
    "smoke:no-activate": "tsx tests/smoke-no-activate.ts",
    "smoke:clipboard": "tsx tests/smoke-clipboard.ts",
    "smoke:window-state": "tsx tests/smoke-window-state.ts",
    "smoke:wait-for-window": "tsx tests/smoke-wait-for-window.ts",
    "smoke:uia-notepad": "tsx tests/smoke-uia-notepad.ts",
    "smoke:run-steps": "tsx tests/smoke-run-steps.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "smoke:app-pack": "tsx tests/smoke-app-pack.ts",
    "smoke:continue-run": "tsx tests/smoke-continue-run.ts",
    "smoke:first-use-pipeline": "tsx tests/smoke-first-use-pipeline.ts",
    "smoke:private-app-pack": "tsx tests/smoke-private-pack.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "screenshot",
    "windows",
    "codex",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}